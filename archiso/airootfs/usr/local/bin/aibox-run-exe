#!/usr/bin/env bash
# aibox-run-exe : lance un programme Windows (.exe, .msi) avec un Proton déjà
# installé (umu-run), sans rien réinstaller pour chaque programme.
#
#   aibox-run-exe PROGRAMME.exe [arguments…]      (ou double-clic dans Thunar)
#
# Proton : PROTON dans ~/.config/aibox/proton.conf (nom d'un dossier de
# ~/.local/share/Steam/compatibilitytools.d, ou chemin complet) ; sinon le
# proton-cachyos le plus récent installé ; sinon UMU-Proton, téléchargé une seule
# fois par umu. Les Proton sont partagés avec Steam et wsquashfs-launcher.
# Préfixe Wine : un seul, partagé (~/.local/share/aibox/wine/default) : les
# dépendances (.NET, VC++…) ne s'installent qu'une fois. WINEPREFIX=… pour un autre.
# Journal : ~/.cache/aibox/run-exe/<programme>.log
set -euo pipefail
[[ $# -ge 1 ]] || { sed -n '2,13p' "$0" | sed 's/^# \{0,1\}//'; exit 1; }
file="$(realpath "$1")"; shift
[[ -f "$file" ]] || { echo "$file introuvable." >&2; exit 1; }

conf="${HOME}/.config/aibox/proton.conf"
PROTON=""
[[ -r "$conf" ]] && . "$conf"
dirs=("${HOME}/.local/share/Steam/compatibilitytools.d" /usr/share/steam/compatibilitytools.d)
if [[ -n "$PROTON" && "$PROTON" != /* ]]; then
    for d in "${dirs[@]}"; do [[ -d "$d/$PROTON" ]] && { PROTON="$d/$PROTON"; break; }; done
fi
if [[ -z "$PROTON" ]]; then
    PROTON="$(for d in "${dirs[@]}"; do ls -d "$d"/proton-cachyos* 2>/dev/null; done | sort -V | tail -n 1 || true)"
fi
if [[ -n "$PROTON" ]]; then export PROTONPATH="$PROTON"; fi   # sinon : UMU-Proton

export WINEPREFIX="${WINEPREFIX:-${HOME}/.local/share/aibox/wine/default}"
export GAMEID="${GAMEID:-umu-default}"
mkdir -p "$WINEPREFIX" "${HOME}/.cache/aibox/run-exe"
log="${HOME}/.cache/aibox/run-exe/$(basename "$file").log"
cd "$(dirname "$file")"

case "${file,,}" in
    *.msi) set -- msiexec /i "$file" "$@" ;;
    *)     set -- "$file" "$@" ;;
esac
{ echo "== $(date) : $*"; echo "Proton : ${PROTONPATH:-UMU-Proton (par défaut)}  Préfixe : $WINEPREFIX"; } >> "$log"
exec umu-run "$@" >> "$log" 2>&1
