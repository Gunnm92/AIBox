#!/usr/bin/env bash
# aibox-tv-mode [gamescope|labwc] : mode de la session TV, gardé dans
# ~/.config/aibox/tv-mode, puis session TV relancée. Sans argument : mode actuel.
#   gamescope : Steam Big Picture sous gamescope (HDR, FSR) — par défaut ;
#   labwc     : labwc et le lanceur à tuiles (Steam, Moonlight) — secours.
set -euo pipefail
conf="${HOME}/.config/aibox/tv-mode"
case "${1:-}" in
    "") cat "$conf" 2>/dev/null || echo gamescope; exit 0 ;;
    gamescope|labwc) ;;
    *) sed -n '2,5p' "$0" | sed 's/^# \{0,1\}//'; exit 1 ;;
esac
mkdir -p "${conf%/*}"
echo "$1" > "$conf"
echo "Session TV : $1 (redémarrage de la session)"
sudo systemctl restart aibox-tv
