#!/usr/bin/env bash
# admin-wait : attend le socket du compositeur d'administration (wayland-0),
# 30 s au plus.
# Relance : à l'arrêt de la session TV, aibox-tv.service relance les
# applications au démarrage (admin-autostart, 22/11/2026). Le panneau tourne
# déjà : elles s'y accrochent comme au démarrage.
# admin-wait zone-notification : attend la zone de notification du panneau XFCE
# (org.kde.StatusNotifierWatcher), 20 s au plus, et réussit toujours. En
# ExecStartPost du panneau : il n'est « prêt » pour systemd qu'une fois elle
# présente, et les applications au démarrage, ordonnées après lui, ne partent
# qu'à ce moment (une icône lancée avant s'arrête : wsquashfs-launcher --tray,
# 16/11/2026). Sans zone de notification, le panneau est prêt au bout de 20 s.
if [[ "${1:-}" == zone-notification ]]; then
    for _ in $(seq 1 40); do
        busctl --user status org.kde.StatusNotifierWatcher >/dev/null 2>&1 && exit 0
        sleep 0.5
    done
    echo "zone de notification absente après 20 s" >&2
    exit 0
fi
for _ in $(seq 1 60); do
    [[ -S "${XDG_RUNTIME_DIR}/wayland-0" ]] && exit 0
    sleep 0.5
done
echo "wayland-0 absent après 30 s" >&2
exit 1
