#!/usr/bin/env bash
# Flathub et les applis de base du bureau, installées sur le disque de données
# (pas dans l'image) au premier démarrage avec le disque :
#   Bazaar      magasin d'applications Flathub (interface graphique)
#   Gear Lever  gestion des AppImage (ajout au menu, mises à jour)
set -euo pipefail
flatpak remote-add --system --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo
for app in io.github.kolunmi.Bazaar it.mijorus.gearlever; do
    flatpak info --system "$app" >/dev/null 2>&1 && continue
    echo "Installation de $app..."
    flatpak install --system --noninteractive flathub "$app"
done
# Thème des applis libadwaita en Flatpak : ~/.config/gtk-4.0 (CSS copié par
# admin-session) en lecture pour toutes les applis.
flatpak override --system --filesystem=xdg-config/gtk-4.0:ro
