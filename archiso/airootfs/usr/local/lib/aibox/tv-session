#!/usr/bin/env bash
# Session TV sur l'écran réel (GPU), selon ~/.config/aibox/tv-mode (aibox-tv-mode) :
#   gamescope (défaut) : gamescope pilote la TV (HDR, FSR, VRR) et lance le
#                        lanceur, qui démarre Steam en mode SteamOS (comme
#                        gamescope-session) ou Moonlight ;
#   labwc (secours)    : labwc, configuration /etc/aibox/labwc-tv, et le lanceur.
# Le bureau d'administration (labwc headless) doit déjà avoir pris wayland-0 et
# :0 : sinon ce compositeur les lui volerait (cf. SteamBox).
set -euo pipefail
for _ in $(seq 1 60); do
    [[ -S "${XDG_RUNTIME_DIR}/wayland-0" ]] && break
    sleep 0.5
done
[[ -S "${XDG_RUNTIME_DIR}/wayland-0" ]] || { echo "wayland-0 (administration) absent : refus de démarrer" >&2; exit 1; }
cd "${HOME}"
unset WAYLAND_DISPLAY DISPLAY
mode="$(cat "${HOME}/.config/aibox/tv-mode" 2>/dev/null || true)"
# La session (PAM/systemd) arrive avec CAP_WAKE_ALARM en capacité ambiante,
# héritée par toutes les applis : le bac à sable de Steam (bwrap) refuse alors
# de démarrer (« Unexpected capabilities but not setuid »), et Steam conclut à
# tort que les espaces de noms utilisateur sont désactivés. On les retire.
nocaps=(setpriv --inh-caps=-all --ambient-caps=-all)

if [[ "$mode" == labwc ]]; then
    export AIBOX_TV_MODE=labwc
    exec "${nocaps[@]}" labwc -C /etc/aibox/labwc-tv
fi

# Réglages de gamescope-session (Steam en mode SteamOS) : menu rapide avec
# HDR, VRR, limite d'images et filtre de mise à l'échelle (FSR).
export STEAM_GAMESCOPE_HDR_SUPPORTED=1 STEAM_GAMESCOPE_VRR_SUPPORTED=1 \
    STEAM_GAMESCOPE_TEARING_SUPPORTED=1 STEAM_GAMESCOPE_DYNAMIC_FPSLIMITER=1 \
    STEAM_GAMESCOPE_FANCY_SCALING_SUPPORT=1 STEAM_MULTIPLE_XWAYLANDS=1 \
    SRT_URLOPEN_PREFER_STEAM=1 QT_IM_MODULE=steam GTK_IM_MODULE=Steam
# command_gamescope de tv-apps.json : Steam en mode SteamOS.
export AIBOX_TV_MODE=gamescope
# Pas de -W/-H : la résolution préférée de la TV. gamescope s'arrête avec le
# lanceur, et le service relance la session (Restart=always).
exec "${nocaps[@]}" gamescope --steam -e --xwayland-count 2 --hdr-enabled -- \
    aibox-tv-launcher
