#!/usr/bin/env bash
# Monte le disque de données AIBOXDATA s'il est présent (sinon : mode éphémère,
# rien n'est monté et rien n'échoue). Crée d'abord les sous-volumes ajoutés depuis
# sa préparation (liste : /usr/local/lib/aibox/subvolumes), puis monte
# /etc/aibox/fstab.data et active le swap de secours.
set -uo pipefail
dev=/dev/disk/by-label/AIBOXDATA
for _ in $(seq 1 50); do [[ -e "$dev" ]] && break; sleep 0.1; done
mkdir -p /run/aibox
if [[ ! -e "$dev" ]]; then
    # Mode éphémère : /home en tmpfs de 16 Go maximum (la RAM n'est prise que
    # pour ce qui y est écrit) au lieu de l'overlay du système limité à 1 Go,
    # pour pouvoir tester Steam, etc. Tout est perdu au redémarrage.
    mount -t tmpfs -o mode=0755,size=16G,nosuid,nodev tmpfs /home
    echo "Pas de disque AIBOXDATA : mode éphémère (/home en RAM, 16 Go max)."
    exit 0
fi
touch /run/aibox/data-present

top=/run/aibox/data-top
mkdir -p "$top"
if mount -o subvolid=5 "$dev" "$top"; then
    grep -vE '^\s*(#|$)' /usr/local/lib/aibox/subvolumes | while read -r sv flag; do
        [[ -d "$top/$sv" ]] && continue
        btrfs -q subvolume create "$top/$sv" && echo "Sous-volume ajouté : $sv"
        [[ "$flag" == nocow ]] && chattr +C "$top/$sv"
    done
    umount "$top"
fi

# Points de montage (créés au besoin), puis montages dans l'ordre du fichier
awk '!/^\s*(#|$)/ {print $2}' /etc/aibox/fstab.data | xargs -r mkdir -p
mount -a -T /etc/aibox/fstab.data
swapon /var/lib/aibox/swap/swapfile 2>/dev/null || true
findmnt -n -o TARGET,SOURCE /home
