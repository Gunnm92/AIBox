#!/usr/bin/env bash
# Session TV au démarrage de la machine, si la manette est déjà allumée.
# La règle udev (71-aibox-tv.rules) ne voit pas ce cas : le dongle est déjà là
# avant que systemd ne surveille les périphériques. Et le dongle s'annonce aussi
# manette éteinte (à la mise sous tension du PC, jusqu'à la première connexion
# de la manette) : sa seule présence ne suffit pas. Une manette connectée envoie
# en continu des rapports qui changent (compteur, gyroscope) : on en lit une
# seconde sur son hidraw ; au moins deux rapports différents → session TV.
set -uo pipefail
hidraw=""
for _ in $(seq 1 20); do
    for u in /sys/class/hidraw/hidraw*/device/uevent; do
        grep -qE 'HID_ID=0003:0000054C:0000(0CE6|0DF2)' "$u" 2>/dev/null || continue
        # Interface de la manette (rapports d'état 0x01), pas l'interface clavier.
        h="${u%/device/uevent}"; h="/dev/${h##*/}"
        if timeout 0.3 head -c 1 "$h" 2>/dev/null | od -An -tx1 | grep -q 01; then
            hidraw="$h"; break 2
        fi
    done
    sleep 0.5
done
[[ -n "$hidraw" ]] || { echo "Pas de manette DualSense : pas de session TV."; exit 0; }
distinct=$(timeout 1 head -c 6400 "$hidraw" 2>/dev/null | od -An -v -tx1 -w64 | sort -u | wc -l)
if (( distinct >= 2 )); then
    echo "Manette allumée ($hidraw, $distinct rapports différents) : session TV."
    systemctl --no-block start aibox-tv.service
else
    echo "Dongle présent, manette éteinte ($hidraw) : pas de session TV."
fi
