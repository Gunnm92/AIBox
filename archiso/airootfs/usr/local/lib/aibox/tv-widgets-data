#!/usr/bin/env python3
"""Données des widgets de la TV (bandeau quickshell, /etc/aibox/quickshell-tv).

Écrit un JSON sur stdout : météo, titres de presse, état de la machine. La météo
et les titres viennent du réseau ; ils sont gardés dans ~/.cache/aibox pendant
15 minutes, et l'état de la machine est lu à chaque appel. En cas d'échec réseau,
le cache périmé reste affiché. Configuration : ~/.config/aibox/tv-widgets.json,
remplacé par /etc/aibox/tv-widgets.json.
"""
import glob
import hashlib
import json
import os
import re
import subprocess
import time
import urllib.parse
import urllib.request
import xml.etree.ElementTree as ET
from datetime import datetime

CONFIGS = [os.path.expanduser("~/.config/aibox/tv-widgets.json"), "/etc/aibox/tv-widgets.json"]
CACHE = os.path.expanduser("~/.cache/aibox/tv-widgets.json")
TTL = 15 * 60
UA = "aibox-tv/1.0"
# Jours de la météo, en français (lundi = 0), sans dépendre de la locale.
JOURS = ["Lun.", "Mar.", "Mer.", "Jeu.", "Ven.", "Sam.", "Dim."]


def load_config():
    for path in CONFIGS:
        if os.path.exists(path):
            with open(path) as f:
                return json.load(f)
    return {"latitude": 0, "longitude": 0, "city": "", "feeds": []}


def wmo(code):
    """Libellé et icône d'un code météo WMO (Open-Meteo)."""
    if code == 0:
        return "Dégagé", "clear"
    if code in (1, 2):
        return "Peu nuageux", "partly"
    if code == 3:
        return "Couvert", "cloud"
    if code in (45, 48):
        return "Brouillard", "fog"
    if 51 <= code <= 67 or 80 <= code <= 82:
        return "Pluie", "rain"
    if 71 <= code <= 77 or code in (85, 86):
        return "Neige", "snow"
    if code >= 95:
        return "Orage", "storm"
    return "Variable", "cloud"


def fetch_weather(cfg):
    query = urllib.parse.urlencode({
        "latitude": cfg["latitude"],
        "longitude": cfg["longitude"],
        "current": "temperature_2m,weather_code",
        "daily": "weather_code,temperature_2m_max,temperature_2m_min",
        "timezone": "auto",
        "forecast_days": 4,
    })
    req = urllib.request.Request("https://api.open-meteo.com/v1/forecast?" + query, headers={"User-Agent": UA})
    with urllib.request.urlopen(req, timeout=10) as r:
        data = json.load(r)
    now_label, now_icon = wmo(data["current"]["weather_code"])
    days = []
    for i, day in enumerate(data["daily"]["time"][1:4], start=1):
        label, icon = wmo(data["daily"]["weather_code"][i])
        days.append({
            "day": JOURS[datetime.fromisoformat(day).weekday()],
            "min": round(data["daily"]["temperature_2m_min"][i]),
            "max": round(data["daily"]["temperature_2m_max"][i]),
            "icon": icon,
        })
    return {
        "temp": round(data["current"]["temperature_2m"]),
        "label": now_label,
        "icon": now_icon,
        "days": days,
    }


IMG_CACHE = os.path.expanduser("~/.cache/aibox/news-img")
IMG_MAX = 14  # images téléchargées par passage (au plus 8 Mo chacune)


def item_image_url(node):
    """URL de l'image d'un article : média RSS, pièce jointe image, ou <img> du résumé."""
    for el in node.iter():
        tag = el.tag.split("}")[-1]
        if tag in ("content", "thumbnail") and el.get("url"):
            return el.get("url")
        if tag == "enclosure" and (el.get("type") or "").startswith("image") and el.get("url"):
            return el.get("url")
    for tag in ("description", "{http://purl.org/rss/1.0/modules/content/}encoded"):
        d = node.find(tag)
        if d is not None and d.text:
            m = re.search(r'<img[^>]+src="([^"]+)"', d.text)
            if m:
                return m.group(1)
    return ""


def local_image(url, budget):
    """Chemin local de l'image (téléchargée une fois, puis gardée), ou "" ; budget = [restant]."""
    if not url:
        return ""
    key = hashlib.sha1(url.encode()).hexdigest()[:20]
    path = os.path.join(IMG_CACHE, key + ".img")
    if os.path.exists(path) and os.path.getsize(path) > 0:
        return path
    if budget[0] <= 0:
        return ""
    budget[0] -= 1
    try:
        os.makedirs(IMG_CACHE, exist_ok=True)
        req = urllib.request.Request(url, headers={"User-Agent": UA})
        with urllib.request.urlopen(req, timeout=6) as r:
            data = r.read(8 * 1024 * 1024)
        if not data:
            return ""
        tmp = path + ".part"
        with open(tmp, "wb") as f:
            f.write(data)
        os.replace(tmp, path)
        return path
    except (OSError, ValueError):
        return ""


def purge_images(keep):
    """Supprime les images d'articles qui ne sont plus affichées, après un jour."""
    limit = time.time() - 86400
    for path in glob.glob(os.path.join(IMG_CACHE, "*")):
        try:
            if path not in keep and os.path.getmtime(path) < limit:
                os.remove(path)
        except OSError:
            pass


def fetch_news(feeds):
    """Titres des flux RSS ou Atom avec leur image locale, six par flux, en alternance."""
    per_feed = []
    budget = [IMG_MAX]
    for feed in feeds:
        try:
            req = urllib.request.Request(feed["url"], headers={"User-Agent": UA})
            with urllib.request.urlopen(req, timeout=10) as r:
                root = ET.fromstring(r.read())
        except (OSError, ET.ParseError, ValueError):
            continue
        titles = []
        for node in list(root.iter("item")) + list(root.iter("{http://www.w3.org/2005/Atom}entry")):
            t = node.find("title") if node.find("title") is not None else node.find("{http://www.w3.org/2005/Atom}title")
            if t is not None and t.text:
                titles.append({
                    "source": feed["name"],
                    "title": " ".join(t.text.split()),
                    "image": local_image(item_image_url(node), budget),
                })
            if len(titles) == 6:
                break
        per_feed.append(titles)
    out = []
    for i in range(6):
        for titles in per_feed:
            if i < len(titles):
                out.append(titles[i])
    return out


def cached_or_fetch(cfg):
    """Météo et titres : cache frais, sinon réseau, sinon cache périmé."""
    stale = None
    try:
        with open(CACHE) as f:
            stale = json.load(f)
        if time.time() - stale["ts"] < TTL and stale.get("city") == cfg.get("city"):
            return stale, []
    except (OSError, ValueError, KeyError):
        pass
    errors = []
    fresh = {"ts": time.time(), "city": cfg.get("city")}
    try:
        fresh["weather"] = fetch_weather(cfg)
    except (OSError, ValueError, KeyError, IndexError):
        errors.append("météo indisponible")
        fresh["weather"] = stale.get("weather") if stale else None
    fresh["news"] = fetch_news(cfg.get("feeds", []))
    if not fresh["news"]:
        errors.append("titres indisponibles")
        fresh["news"] = stale.get("news", []) if stale else []
    if errors and stale and not fresh["weather"]:
        return stale, errors
    os.makedirs(os.path.dirname(CACHE), exist_ok=True)
    with open(CACHE, "w") as f:
        json.dump(fresh, f)
    purge_images({n.get("image") for n in fresh["news"]})
    return fresh, errors


def system_state():
    mem = {}
    with open("/proc/meminfo") as f:
        for line in f:
            key, _, rest = line.partition(":")
            mem[key] = int(rest.split()[0])
    ram_used = round(100 * (1 - mem["MemAvailable"] / mem["MemTotal"]))
    gpu_temp = None
    for name in glob.glob("/sys/class/hwmon/hwmon*/name"):
        with open(name) as f:
            if f.read().strip() == "amdgpu":
                try:
                    with open(os.path.join(os.path.dirname(name), "temp1_input")) as t:
                        gpu_temp = round(int(t.read()) / 1000)
                except OSError:
                    pass
                break
    containers = []
    try:
        out = subprocess.run(["podman", "ps", "--format", "{{.Names}}"],
                             capture_output=True, text=True, timeout=5).stdout
        containers = [n for n in out.split() if n]
    except (OSError, subprocess.TimeoutExpired):
        pass
    return {
        "ram": ram_used,
        "gpu_temp": gpu_temp,
        "containers": len(containers),
        "container_names": containers,
    }


LEMONADE = "http://127.0.0.1:13305/api/v1"


def model_name(m):
    if isinstance(m, dict):
        return m.get("checkpoint") or m.get("model_name") or m.get("name") or str(m)
    return str(m)


def fetch_lemonade():
    """État de Lemonade (serveur LLM local) : débit, requêtes et modèle chargé.
    Lu à chaque appel, sans cache ; None si le serveur ne répond pas."""
    try:
        with urllib.request.urlopen(LEMONADE + "/stats", timeout=3) as r:
            stats = json.load(r)
        with urllib.request.urlopen(LEMONADE + "/health", timeout=3) as r:
            health = json.load(r)
    except (OSError, ValueError):
        return None
    live = stats.get("live") or {}
    return {
        "active": live.get("active_requests", 0),
        "tps": round(live.get("estimated_tokens_per_second") or 0, 1),
        "requests": stats.get("request_count_total", 0),
        "tokens_in": stats.get("input_tokens_total", 0),
        "tokens_out": stats.get("output_tokens_total", 0),
        "loaded": [model_name(m) for m in (health.get("all_models_loaded") or [])],
    }


def newest_wallpaper():
    """Fond d'écran Bing le plus récent du cache (sa couleur sert de thème)."""
    files = glob.glob(os.path.expanduser("~/.cache/aibox/bing-*.jpg"))
    return sorted(files)[-1] if files else ""  # nom = date AAAAMMJJ


def main():
    cfg = load_config()
    data, errors = cached_or_fetch(cfg)
    print(json.dumps({
        "updated": datetime.now().strftime("%H:%M"),
        "city": cfg.get("city", ""),
        "weather": data.get("weather"),
        "news": data.get("news", []),
        "system": system_state(),
        "lemonade": fetch_lemonade(),
        "wallpaper": newest_wallpaper(),
        "errors": errors,
    }, ensure_ascii=False))


if __name__ == "__main__":
    main()
