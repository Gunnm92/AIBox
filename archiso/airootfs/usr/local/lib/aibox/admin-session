#!/usr/bin/env bash
# Session Plasma du bureau d'administration (27/11/2026, reprise de
# plasma-session.sh de SteamBox), lancée par aibox-admin-plasma.service :
# prépare la configuration, puis se remplace par startplasma-wayland, imbriqué
# dans le compositeur de Selkies (aibox-admin-selkies). Son KWin prend le
# premier socket wayland-N libre (à partir de 1, jamais le même) ; l'autostart
# session-env le publie sous le nom wayland-admin, que Selkies vise
# (SELKIES_APP_WAYLAND_DISPLAY).
# Bus de session principal (celui de systemd) : startplasma y pousse son
# affichage pour tout ce que D-Bus et systemd lancent. Sans les unités
# plasma-*.service (/etc/xdg/startkderc) : la session TV a aussi son Plasma.
# Remplace labwc headless et les services XFCE (retirés le 27/11/2026).
set -euo pipefail
cd "${HOME}"

# Socket du compositeur de Selkies : il choisit lui-même le premier wayland-N
# libre à partir de 1 ; on le retrouve parmi les sockets en écoute de son
# processus. 30 s au plus, sinon échec et relance par systemd.
selkies="$(systemctl --user show -P MainPID aibox-admin-selkies.service)"
hote=""
for _ in $(seq 1 60); do
    if [[ -n "$selkies" && "$selkies" != 0 ]]; then
        hote="$(ss -xlpn 2>/dev/null | grep -F "pid=${selkies}," \
            | grep -oE "${XDG_RUNTIME_DIR}/wayland-[0-9]+ " | head -n 1 | xargs -r basename || true)"
        [[ -n "$hote" ]] && break
    fi
    sleep 0.5
    selkies="$(systemctl --user show -P MainPID aibox-admin-selkies.service)"
done
[[ -n "$hote" ]] || { echo "compositeur de Selkies introuvable après 30 s" >&2; exit 1; }
# Lien de la session précédente retiré : son socket peut être repris entre-temps
# par la TV, et Selkies y enverrait le clavier et la souris. session-env le
# refait pour cette session.
rm -f "${XDG_RUNTIME_DIR}/wayland-admin"

# Verrouillage d'écran coupé : default n'a pas de mot de passe Unix, un bureau
# verrouillé le resterait. L'accès est protégé par le mot de passe de nginx.
# (~/.config est partagé avec la session TV : pas de verrouillage non plus.)
kwriteconfig6 --file kscreenlockerrc --group Daemon --key Autolock false
kwriteconfig6 --file kscreenlockerrc --group Daemon --key LockOnResume false

# Applis GTK : thème, icônes et curseur WhiteSur, écrits SEULEMENT s'ils
# manquent. Plasma les réécrit (Paramètres → Apparence → Style des
# applications) : un choix de l'utilisateur n'est jamais écrasé.
mkdir -p "${HOME}/.config/gtk-3.0" "${HOME}/.config/gtk-4.0"
if [[ ! -e "${HOME}/.config/gtk-3.0/settings.ini" ]]; then
    cat > "${HOME}/.config/gtk-3.0/settings.ini" <<EOT
[Settings]
gtk-theme-name=WhiteSur-Dark
gtk-application-prefer-dark-theme=1
gtk-icon-theme-name=WhiteSur-dark
gtk-cursor-theme-name=WhiteSur-cursors
gtk-cursor-theme-size=24
EOT
fi
[[ -e "${HOME}/.config/gtk-4.0/settings.ini" ]] \
    || cp "${HOME}/.config/gtk-3.0/settings.ini" "${HOME}/.config/gtk-4.0/settings.ini"

# Cache de polices à jour avant tout composant graphique (cf. SteamBox : glycin
# tué par seccomp si le cache est incomplet).
fc-cache 2>/dev/null || true

# KWin imbriqué : WAYLAND_DISPLAY désigne son hôte (Selkies) ; DISPLAY est
# celui que KWin créera pour son Xwayland, jamais un hérité.
# PULSE_SINK : le son des applis du bureau sort dans le navigateur (puits
# « selkies »), pas sur la TV (essai du 27/11/2026).
# QT_QPA_PLATFORM : repli X11 pour les applis Qt sans greffon Wayland (AppImage).
# XDG_DATA_DIRS : applis Flatpak (système et utilisateur) dans le menu.
unset DISPLAY
export WAYLAND_DISPLAY="$hote" XDG_SESSION_TYPE=wayland XDG_CURRENT_DESKTOP=KDE \
    XDG_SESSION_DESKTOP=plasma DESKTOP_SESSION=plasma \
    KWIN_WAYLAND_NO_PERMISSION_CHECKS=1 PULSE_SINK=selkies \
    "QT_QPA_PLATFORM=wayland;xcb" \
    XDG_DATA_DIRS="${HOME}/.local/share/flatpak/exports/share:/var/lib/flatpak/exports/share:/usr/local/share:/usr/share"
exec startplasma-wayland
