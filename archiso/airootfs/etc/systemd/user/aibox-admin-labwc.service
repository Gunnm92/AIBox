[Unit]
Description=Bureau d'administration : compositeur labwc headless (wayland-0)
PartOf=aibox-admin.target

[Service]
Slice=admin.slice
# Pas d'écran réel. Rendu sur le GPU (gles2, nœud de rendu, sans siège ni
# écran) : wayvnc --gpu lit les images dans la mémoire du GPU et les encode en
# H.264 (VAAPI) pour noVNC — plus fluide que le rendu logiciel (pixman) d'avant
# (11/10/2026) ; charge GPU négligeable pour un bureau. LIBSEAT_BACKEND=noop :
# pas de siège/VT.
Environment=WLR_BACKENDS=headless WLR_RENDERER=gles2 LIBSEAT_BACKEND=noop WLR_LIBINPUT_NO_DEVICES=1
Environment=XDG_CURRENT_DESKTOP=XFCE XDG_SESSION_TYPE=wayland
ExecStart=/usr/local/lib/aibox/admin-session
Restart=always
RestartSec=2
