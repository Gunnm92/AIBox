# Applications au démarrage du bureau d'administration (~/.config/autostart et
# /etc/xdg/autostart, réglables dans Paramètres → Session et démarrage).
# xdg-desktop-autostart.target refuse un démarrage direct (RefuseManualStart) :
# cette cible le tire comme dépendance. Les unités générées pour chaque
# application attendent le panneau (app-.service.d/aibox-admin.conf).
# Pas de graphical-session.target : portails, gvfs et flatpak y sont rattachés,
# et la session TV les partage.
# L'arrêt de la session TV tue les applications rattachées à graphical-session.target ;
# aibox-tv.service les relance (ExecStopPost, /usr/local/lib/aibox/admin-autostart),
# car démarrer cette cible, déjà active, ne les relancerait pas (22/11/2026).
[Unit]
Description=Bureau d'administration : applications au démarrage (XDG autostart)
PartOf=aibox-admin.target
Wants=xdg-desktop-autostart.target
After=aibox-admin-panel.service
