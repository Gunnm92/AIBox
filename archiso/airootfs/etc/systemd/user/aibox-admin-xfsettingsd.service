[Unit]
Description=Bureau d'administration : réglages XFCE (thème, icônes, police)
PartOf=aibox-admin.target
Requires=aibox-admin-labwc.service
After=aibox-admin-labwc.service 

[Service]
# Prêt quand il publie les réglages GTK (org.gtk.Settings), pas dès son
# lancement : xfdesktop, puis Thunar qu'il réveille, chargeaient sinon le
# thème par défaut (Thunar, démon, ne suit pas les changements à chaud).
Type=dbus
BusName=org.gtk.Settings
Slice=admin.slice
WorkingDirectory=%h
EnvironmentFile=/etc/aibox/admin-desktop.env
ExecStartPre=/usr/local/lib/aibox/admin-wait
ExecStart=/usr/local/lib/aibox/xfce-defaults HEADLESS-1 -- /usr/bin/xfsettingsd --no-daemon
Restart=always
RestartSec=2
