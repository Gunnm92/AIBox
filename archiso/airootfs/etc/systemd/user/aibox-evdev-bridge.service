[Unit]
Description=Clavier et souris de Moonlight dans le bureau d'administration (evdev-bridge)
# Démarré et arrêté avec Sunshine (app-dev.lizardbyte.app.Sunshine.service.d).
PartOf=app-dev.lizardbyte.app.Sunshine.service
After=app-dev.lizardbyte.app.Sunshine.service aibox-admin-labwc.service

[Service]
Slice=admin.slice
ExecStart=/usr/local/lib/aibox/evdev-bridge
# Restart=always, pas on-failure : evdev-bridge sort avec le code 0 quand un
# périphérique virtuel de Sunshine disparaît (fin de session Moonlight).
Restart=always
RestartSec=2
