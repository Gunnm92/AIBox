[Unit]
Description=Bureau d'administration : fond d'écran et icônes du bureau (xfdesktop)
PartOf=aibox-admin.target
Requires=aibox-admin-labwc.service
After=aibox-admin-labwc.service aibox-admin-xfsettingsd.service

[Service]
Slice=admin.slice
WorkingDirectory=%h
EnvironmentFile=/etc/aibox/admin-desktop.env
ExecStartPre=/usr/local/lib/aibox/admin-wait
ExecStart=/usr/bin/xfdesktop
Restart=always
RestartSec=2
