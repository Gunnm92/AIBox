[Unit]
Description=Bureau d'administration : noVNC en HTTPS (https://<ip>:6080)
PartOf=aibox-admin.target

[Service]
Slice=admin.slice
# HTTPS : noVNC exige un contexte sécurisé, et le mot de passe (authentification
# HTTP de nginx) ne doit pas circuler en clair. nginx sert les pages et relaie
# /websockify vers le pont WebSocket local.
ExecStart=/usr/bin/nginx -c /etc/aibox/nginx.conf -e stderr -g "daemon off;"
Restart=always
RestartSec=2
