[Unit]
Description=Flathub, magasin d'applications (Bazaar) et Gear Lever, sur le disque de données
Wants=network-online.target
After=network-online.target aibox-data.service
ConditionPathIsMountPoint=/var/lib/flatpak

[Service]
Type=oneshot
TimeoutStartSec=30min
RemainAfterExit=yes
ExecStart=/usr/local/lib/aibox/flathub-setup
Restart=on-failure
RestartSec=30

[Install]
WantedBy=multi-user.target
