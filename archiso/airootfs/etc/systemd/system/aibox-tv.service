[Unit]
Description=Session TV (labwc plein écran, lanceur Steam / Moonlight)
After=systemd-user-sessions.service user@1000.service aibox-data.service
Wants=user@1000.service
# La session prend l'écran et tty1 (plus de console en connexion automatique).
Conflicts=getty@tty1.service
After=getty@tty1.service

[Service]
Slice=tv.slice
User=default
WorkingDirectory=/home/default
# Vraie session logind sur le siège (accès au GPU et aux entrées), sur tty1.
PAMName=login
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty-fail
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty1
UtmpMode=user
Environment=XDG_SESSION_TYPE=wayland XDG_CURRENT_DESKTOP=aibox-tv LANG=fr_FR.UTF-8
Environment=XDG_RUNTIME_DIR=/run/user/1000 DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus
Environment=XDG_DATA_DIRS=/home/default/.local/share/flatpak/exports/share:/var/lib/flatpak/exports/share:/usr/local/share:/usr/share
ExecStart=/usr/local/lib/aibox/tv-session
# À l'arrêt, labwc efface l'environnement d'activation : on le remet sur l'administration.
ExecStopPost=/usr/local/lib/aibox/activation-env-admin
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
