# Disposition du clavier rejoué par evdev-bridge (Moonlight, Sunshine), par
# défaut Mac français (voir /etc/xkb/symbols/aibox). Réglage de l'utilisateur :
# ~/.config/aibox/keyboard.env. Le bureau Selkies n'en a pas besoin : le
# navigateur envoie les caractères tapés (27/11/2026).
KEYBOARD_LAYOUT=aibox
KEYBOARD_VARIANT=fr_mac
