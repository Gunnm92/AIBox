<?xml version="1.0"?>
<!-- labwc de la session TV : pas de décorations, chaque fenêtre en plein écran, HDR. -->
<labwc_config>
  <core>
    <xwaylandPersistence>yes</xwaylandPersistence>
    <!-- HDR activé sur la TV quand elle le gère (rendu Vulkan : environment). -->
    <hdr>yes</hdr>
  </core>
  <windowRules>
    <windowRule identifier="*" serverDecoration="no">
      <action name="Maximize"/>
    </windowRule>
  </windowRules>
</labwc_config>
