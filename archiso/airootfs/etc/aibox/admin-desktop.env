# Environnement des composants du bureau d'administration (et de ce qu'ils lancent).
# DISPLAY=:0 : Xwayland de labwc, démarré à la demande (seul serveur X de la machine).
WAYLAND_DISPLAY=wayland-0
DISPLAY=:0
XDG_CURRENT_DESKTOP=XFCE
XDG_SESSION_TYPE=wayland
QT_QPA_PLATFORM=wayland
# Applis Flatpak (système et utilisateur) dans le menu
XDG_DATA_DIRS=/home/default/.local/share/flatpak/exports/share:/var/lib/flatpak/exports/share:/usr/local/share:/usr/share
