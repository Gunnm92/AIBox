# tmpfs limité (voir spec, « Contraintes mémoire »)
tmpfs /dev/shm tmpfs rw,nosuid,nodev,size=8G 0 0

# Le disque de données AIBOXDATA n'est PAS ici : il est monté par
# aibox-data-mount.service (/etc/aibox/fstab.data), seulement s'il est présent.
# Dans /etc/fstab, un disque absent laisserait des montages « en échec », et les
# services qui en dépendent implicitement (session TV via /home, Bluetooth via
# /var/lib/bluetooth…) seraient annulés en mode éphémère.
