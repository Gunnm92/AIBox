cachyos-v4-mirrorlist
# Nom CachyOS dans os-release, lsb-release et issue (crochets pacman), comme une
# installation CachyOS ; sinon le paquet filesystem d'Arch annonce « Arch Linux ».
cachyos-hooks

# Firmwares allégés (pas de linux-firmware complet), d'après le matériel de la machine :
#   amdgpu    GPU Radeon 8060S
#   amd       NPU XDNA 2 (amdxdna), coprocesseur de sécurité (ccp)
#   mediatek  Wi-Fi MT7925 (mt7925e) et son Bluetooth (btusb)
# Ethernet par adaptateur USB (cdc_ncm) et audio HDMI/USB : pas de firmware.
linux-firmware-amdgpu
linux-firmware-amd
linux-firmware-mediatek

# GPU
mesa
vulkan-radeon
vulkan-tools
amdgpu_top

# Réseau, accès, Bluetooth
networkmanager
wireless-regdb
openssh
sudo
bluez
bluez-utils

# Shell de default : fish, avec le résumé de la machine (fastfetch) à l'ouverture
fish
fastfetch

# Bureaux KDE (27/11/2026) : KWin et Plasma pour le bureau d'administration
# (imbriqué dans Selkies, lui-même dans /opt/selkies, installé par build.sh) et
# pour la TV (Plasma Bigscreen). nginx : accès web en HTTPS (Selkies, code-server).
# python : celui du venv de Selkies.
kwin
plasma-desktop
plasma-bigscreen
plasma-nano
plasma-pa
plasma-nm
kscreen
xdg-desktop-portal-kde
konsole
dolphin
kate
# Volume par sortie et par canal (son de la manette, sorties HDMI…)
pavucontrol
nginx
python
xorg-xwayland
# Réseau (smb://), corbeille, clés USB pour les applis GTK ; partages SMB en ligne de commande
gvfs
gvfs-smb
cifs-utils
# Noms en .local (nas.local…) par mDNS, avec avahi
nss-mdns
ttf-dejavu

# Applis sur disque (Flatpak, AppImage) et mémoire
flatpak
fuse2
fuse3
zram-generator

# Conteneurs (développement) : Podman sans root ni démon ; conteneurs et images
# dans ~/.local/share/containers (disque de données). podman-docker : commande docker.
podman
podman-compose
podman-docker

# Outils de base (petits). Le reste (base-devel, compilateurs, SDK, vim…) va dans
# des environnements Distrobox, sur le disque : base-devel seul pèserait 478 Mo.
# make seul (2 Mo) : pour les Makefile de projets qui ne font que lancer des commandes.
git
make
github-cli
distrobox
jq
rsync
tmux
unzip
zip
wget
# ImageMagick (22 Mo) : taille et conversion d'images pour les agents d'Hermes
# (identify, magick), dans le pipeline LinkedIn
imagemagick

# Session TV : Steam natif (bibliothèques 32 bits), son (PipeWire).
# vulkan-virtio : GPU partagé dans une VM (Venus), pour les tests.
# gamescope : Steam en mode SteamOS sur la TV (HDR, FSR, VRR), mode gamescope de la session TV.
steam
gamescope
lib32-mesa
lib32-vulkan-radeon
vulkan-virtio
lib32-vulkan-virtio
pipewire
pipewire-pulse
pipewire-alsa
wireplumber
rtkit
# Jeux : gamemode (gamemoderun %command% dans Steam), son des jeux 32 bits
gamemode
lib32-gamemode
lib32-libpulse

# Sunshine (dépôts CachyOS) : diffusion du bureau d'administration vers
# Moonlight (VAAPI) ; lancé à la main, pas au démarrage. Sous KWin, sans clavier
# ni souris (evdev-bridge ne parle qu'aux compositeurs wlroots).
sunshine

# Jeux Windows au format Batocera (.wsquashfs) : wsquashfs-launcher n'est plus
# dans l'image (binaire installé à part, dans ~/.local/bin) ; les runners
# (proton-cachyos, UMU-Proton…) vont sur le disque, pas de wine système (590 Mo)
squashfuse
fuse-overlayfs
squashfs-tools
umu-launcher

# Bibliothèques 32 bits de wine-tkg (jeux 32 bits, arcade Batocera) qui
# manquaient à wsquashfs-launcher --setup ; sans elles, « no driver could be loaded »
lib32-libxrender
lib32-libxrandr
lib32-libxi
lib32-libxcursor
lib32-libxcomposite
lib32-libxkbcommon
# Presse-papiers de l'icône de wsquashfs-launcher --tray (code d'association)
wl-clipboard
xclip

# LLM : Lemonade (serveur seulement, 14 Mo) ; backends et modèles téléchargés
# par Lemonade dans /srv/models (disque de données)
lemonade-server

# Disque de données et démarrage sur le NVMe (aibox-setup-disk : FAT32)
dosfstools
btrfs-progs
nvme-cli
btop
# GPU AMD dans btop (chargé à l'exécution : librocm_smi64) ; ~31 Mo avec ses
# dépendances ROCm
rocm-smi-lib
less
nano
