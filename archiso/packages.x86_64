# Base et démarrage live
base
linux-cachyos
amd-ucode
mkinitcpio
mkinitcpio-archiso
cachyos-keyring
cachyos-mirrorlist
cachyos-v3-mirrorlist
cachyos-v4-mirrorlist
# Nom CachyOS dans os-release, lsb-release et issue (crochets pacman), comme une
# installation CachyOS ; sinon le paquet filesystem d'Arch annonce « Arch Linux ».
cachyos-hooks

# Firmwares allégés (pas de linux-firmware complet), d'après le matériel de la machine :
#   amdgpu    GPU Radeon 8060S
#   amd       NPU XDNA 2 (amdxdna), coprocesseur de sécurité (ccp)
#   mediatek  Wi-Fi MT7925 (mt7925e) et son Bluetooth (btusb)
# Ethernet par adaptateur USB (cdc_ncm) et audio HDMI/USB : pas de firmware.
linux-firmware-amdgpu
linux-firmware-amd
linux-firmware-mediatek

# GPU
mesa
vulkan-radeon
vulkan-tools
amdgpu_top

# Réseau, accès, Bluetooth
networkmanager
wireless-regdb
openssh
sudo
bluez
bluez-utils

# Shell de default : fish, avec le résumé de la machine (fastfetch) à l'ouverture
fish
fastfetch

# Bureau d'administration (noVNC) : labwc headless + panneau XFCE, wayvnc,
# websocat (pont WebSocket, websockify n'a pas de paquet), nginx (noVNC en HTTPS)
labwc
wlr-randr
wayvnc
websocat
nginx
xfce4-panel
# Volume : icône du panneau et mixeur (son de la manette, sorties HDMI…)
xfce4-pulseaudio-plugin
pavucontrol
xfce4-settings
# Seulement pour Paramètres → Session et démarrage (applications au démarrage) ;
# la session XFCE elle-même n'est pas utilisée (labwc + services).
xfce4-session
xfdesktop
xfce4-appfinder
xfce4-terminal
xfce4-taskmanager
thunar
thunar-volman
mousepad
network-manager-applet
xorg-xwayland
xdg-desktop-portal-gtk
# Réseau dans Thunar (smb://), corbeille, clés USB ; partages SMB en ligne de commande
gvfs
gvfs-smb
cifs-utils
# Noms en .local (nas.local…) par mDNS, avec avahi
nss-mdns
ttf-dejavu

# Applis sur disque (Flatpak, AppImage) et mémoire
flatpak
fuse2
fuse3
zram-generator

# Conteneurs (développement) : Podman sans root ni démon ; conteneurs et images
# dans ~/.local/share/containers (disque de données). podman-docker : commande docker.
podman
podman-compose
podman-docker

# Outils de base (petits). Le reste (base-devel, compilateurs, SDK, vim…) va dans
# des environnements Distrobox, sur le disque : base-devel seul pèserait 478 Mo.
# make seul (2 Mo) : pour les Makefile de projets qui ne font que lancer des commandes.
git
make
github-cli
distrobox
jq
rsync
tmux
unzip
zip
wget

# Session TV : Steam natif (bibliothèques 32 bits), son (PipeWire), lanceur
# (pygame). vulkan-virtio : GPU partagé dans une VM (Venus), pour les tests.
# gamescope : jeux en FSR et en HDR, dans labwc (options de lancement de Steam).
steam
gamescope
lib32-mesa
lib32-vulkan-radeon
vulkan-virtio
lib32-vulkan-virtio
pipewire
pipewire-pulse
pipewire-alsa
wireplumber
rtkit
python-pygame
# Jeux : gamemode (gamemoderun %command% dans Steam), son des jeux 32 bits
gamemode
lib32-gamemode
lib32-libpulse

# RDP (compilé depuis l'AUR au build) : passerelle vers le bureau d'administration
xrdp

# Sunshine (dépôts CachyOS) : diffusion du bureau d'administration vers
# Moonlight (VAAPI) ; lancé à la main, pas au démarrage
sunshine

# Jeux Windows au format Batocera (.wsquashfs) : wsquashfs-launcher (script
# ajouté au build) et ses outils ; les runners (proton-cachyos, UMU-Proton…)
# vont sur le disque, pas de wine système (590 Mo)
squashfuse
fuse-overlayfs
squashfs-tools
umu-launcher

# LLM : Lemonade (serveur seulement, 14 Mo) ; backends et modèles téléchargés
# par Lemonade dans /srv/models (disque de données)
lemonade-server

# Disque de données et démarrage sur le NVMe (aibox-setup-disk : FAT32)
dosfstools
btrfs-progs
nvme-cli
btop
# GPU AMD dans btop (chargé à l'exécution : librocm_smi64) ; ~31 Mo avec ses
# dépendances ROCm
rocm-smi-lib
less
nano
